# Server-only Conductor credentials. Never expose these through VITE_* variables.
CONDUCTOR_API_URL=https://api.conductor.build
CONDUCTOR_API_KEY=replace-with-a-conductor-api-key
# Optional fallback used by machine-launched cloud workspaces.
CONDUCTOR_API_TOKEN=
# Optional in a Conductor cloud workspace; used only for request attribution.
CONDUCTOR_SESSION_ID=
# A repository already included in the active Conductor Cloud Computer build.
# Prefer the stable project ID when available; otherwise configure its GitHub URL.
CONDUCTOR_WORKSPACE_PROJECT_ID=
CONDUCTOR_WORKSPACE_REPOSITORY_URL=https://github.com/your-org/your-host-repository

PORT=8787
DATABASE_PATH=./data/audits.db
AUDIT_POLL_INTERVAL_MS=5000
AUDIT_RETRY_BASE_MS=500
AUDIT_REQUEST_RETRIES=3
AUDIT_REQUEST_TIMEOUT_MS=30000
AUDIT_MAX_POLL_ERRORS=8
AUDIT_MAX_DURATION_MS=7200000
